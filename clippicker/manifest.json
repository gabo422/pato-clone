{
  "manifest_version": 3,
  "name": "ClipPicker",
  "version": "1.0.0",
  "description": "Muestra un panel previo con imágenes del portapapeles y archivos recientes al subir archivos.",
  "permissions": [
    "storage",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}